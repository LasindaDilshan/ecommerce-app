{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/media/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "urls": [
          "https://fonts.googleapis.com/**",
          "https://fonts.gstatic.com/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-products",
      "urls": [
        "**/api/products",
        "**/api/products/*",
        "**/api/products/*/similar",
        "**/api/products/featured"
      ],
      "cacheConfig": {
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-categories",
      "urls": [
        "**/api/categories",
        "**/api/categories/*"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "12h",
        "timeout": "10s",
        "strategy": "performance"
      }
    },
    {
      "name": "api-loyalty",
      "urls": [
        "**/api/loyalty/rewards",
        "**/api/loyalty/summary"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "30m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-qa",
      "urls": [
        "**/api/productqa/products/*/questions"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-user-data",
      "urls": [
        "**/api/cart",
        "**/api/wishlist",
        "**/api/orders"
      ],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "5m",
        "timeout": "5s",
        "strategy": "freshness"
      }
    },
    {
      "name": "api-general",
      "urls": [
        "**/api/**"
      ],
      "cacheConfig": {
        "maxSize": 50,
        "maxAge": "30m",
        "timeout": "10s",
        "strategy": "freshness"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/api/**",
    "!/**/assets/**"
  ]
}
