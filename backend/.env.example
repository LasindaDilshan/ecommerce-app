# ===========================================
# IMPORTANT: Copy this file to .env and update all values
# NEVER commit .env to version control
# ===========================================

# Database Configuration (SQL Server - docker-compose.yml)
DB_PASSWORD=CHANGE_THIS_strong_password_123!

# PostgreSQL Configuration (docker-compose.postgres.yml)
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_THIS_strong_password_123!
POSTGRES_DB=ecommerce_db

# PgAdmin Configuration
PGADMIN_EMAIL=admin@yourdomain.com
PGADMIN_PASSWORD=CHANGE_THIS_admin_password!

# JWT Configuration (minimum 32 characters)
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_KEY_AT_LEAST_32_CHARACTERS_LONG!

# Stripe Configuration (Get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_actual_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_actual_publishable_key_here

# SendGrid Configuration (Get API key from https://sendgrid.com/docs/ui/account-and-settings/api-keys/)
SENDGRID_API_KEY=SG.your_actual_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Your Store Name

# Application URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost

# Environment
ASPNETCORE_ENVIRONMENT=Production
NODE_ENV=production